---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CardFeed from '../../components/CardFeed.astro';
import { sectionOf } from '../../categories';

const cards = await getCollection('cards', (c) => sectionOf(c.data.category) === 'econ');
---

<Base title="경제" section="econ" current="cards">
  <CardFeed cards={cards} />
</Base>
