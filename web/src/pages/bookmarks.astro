---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SECTIONS, sectionOf } from '../categories';
import { href } from '../lib/format';

// 경제 카드는 경제 피드(/econ/#id)에 있다. 북마크에는 글 id만 저장되므로 섹션을 여기서 알려 준다
const econCards = (await getCollection('cards', (c) => sectionOf(c.data.category) === 'econ')).map((c) => c.id);
---

<Base title="북마크" current="bookmarks">
  <h1 id="bookmarks-heading" tabindex="-1">북마크</h1>
  <p class="meta" id="bookmarks-empty" hidden>북마크한 글이 없어요.</p>
  <p class="meta" id="bookmarks-status" role="status"></p>
  <ul id="bookmarks-list" aria-labelledby="bookmarks-heading" data-feed={href(SECTIONS.ai.feed)}
    data-econ-feed={href(SECTIONS.econ.feed)} data-econ-cards={JSON.stringify(econCards)} data-posts={href('/posts/')}></ul>
  <template id="bookmark-row">
    <li>
      <div>
        <p class="meta"></p>
        <a></a>
      </div>
      <button type="button">해제</button>
    </li>
  </template>
  <noscript><p class="meta">북마크를 보려면 자바스크립트를 켜 주세요.</p></noscript>
</Base>

<script>
  import { readBookmarks, writeBookmarks, type Bookmark } from '../lib/bookmarks';

  const heading = document.getElementById('bookmarks-heading')!;
  const empty = document.getElementById('bookmarks-empty')!;
  const status = document.getElementById('bookmarks-status')!;
  const list = document.getElementById('bookmarks-list')!;
  const row = document.querySelector<HTMLTemplateElement>('#bookmark-row')!.content.firstElementChild!;

  const econCards = new Set<string>(JSON.parse(list.dataset.econCards ?? '[]'));

  function paint(items: Bookmark[]) {
    empty.hidden = items.length > 0;
    list.replaceChildren(...items.map(({ id, title }) => {
      const [kind, slug] = id.split('/');
      const li = row.cloneNode(true) as HTMLLIElement;
      const link = li.querySelector('a')!;
      const remove = li.querySelector('button')!;
      const econ = kind === 'cards' && econCards.has(slug);
      li.querySelector('p')!.textContent = kind === 'cards' ? (econ ? '경제' : '속보') : '긴 글';
      link.textContent = title;
      link.href = kind === 'cards' ? `${econ ? list.dataset.econFeed : list.dataset.feed}#${encodeURIComponent(slug)}` :
        `${list.dataset.posts}${encodeURIComponent(slug)}/`;
      remove.setAttribute('aria-label', `해제: ${title}`);
      remove.addEventListener('click', () => {
        const next = writeBookmarks(readBookmarks().filter((item) => item.id !== id));
        status.textContent = next ? '' : '북마크 해제 실패';
        if (next) {
          const adjacent = li.nextElementSibling ?? li.previousElementSibling;
          li.remove();
          empty.hidden = list.childElementCount > 0;
          (adjacent?.querySelector('button') ?? heading).focus();
        }
      });
      return li;
    }));
  }

  paint(readBookmarks());
  addEventListener('storage', () => paint(readBookmarks()));
  addEventListener('pageshow', (event) => {
    if (event.persisted) paint(readBookmarks());
  });
</script>

<style>
  h1 {
    font-size: var(--fs-display);
    font-weight: 700;
    margin-bottom: var(--s-5);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-3) 0;
  }

  li + li {
    border-top: 1px solid var(--line);
  }

  button {
    min-height: 44px;
    padding: 0 var(--s-2);
    font: inherit;
    font-size: var(--fs-small);
    color: var(--muted);
    background: none;
    border: 0;
    cursor: pointer;
    white-space: nowrap;
  }

  button:hover {
    color: var(--text);
    text-decoration: underline;
  }

  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
