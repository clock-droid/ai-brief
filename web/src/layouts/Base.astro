---
import '../styles/global.css';
import Rail from '../components/Rail.astro';
import Signals from '../components/Signals.astro';
import { CATEGORIES, SECTIONS, type CategoryKey, type SectionKey } from '../categories';
import { href } from '../lib/format';

interface Props {
  title?: string;
  description?: string;
  section?: SectionKey; // AI · 경제. 분류 메뉴와 곁줄이 이 섹션 것만 보인다
  current?: 'cards' | 'posts' | 'bookmarks'; // 섹션 안의 속보·긴 글, 또는 북마크
  category?: CategoryKey; // 분류 페이지일 때 왼쪽 메뉴에서 현재 위치로 표시
  railPosts?: boolean; // 곁줄의 긴 글 목록. 긴 글 목록 페이지에서는 본문과 겹치므로 끈다
}

const SITE_NAME = 'AI 브리핑'; // 가제
const { title, description = 'AI와 미래 산업, 경제 소식을 빠르고 깊게.', section = 'ai', current, category, railPosts = true } =
  Astro.props;
const on = (s: SectionKey, page: 'cards' | 'posts') => here(section === s && current === page && !category);
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const here = (on: boolean) => (on ? 'page' : undefined);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="shell">
      <header class="side">
        <a class="site-name" href={href('/')}>{SITE_NAME}</a>
        <nav aria-label="주요 메뉴">
          <a href={href(SECTIONS.ai.feed)} aria-current={on('ai', 'cards')}>속보</a>
          <a href={href(SECTIONS.ai.posts)} aria-current={on('ai', 'posts')}>긴 글</a>
          <a href={href(SECTIONS.econ.feed)} aria-current={on('econ', 'cards')}>경제</a>
          <a href={href(SECTIONS.econ.posts)} aria-current={on('econ', 'posts')}>경제 긴 글</a>
          <a href={href('/bookmarks/')} aria-current={here(current === 'bookmarks')}>북마크</a>
        </nav>
        <nav class="categories" aria-label={`${SECTIONS[section].label} 분류`}>
          {
            SECTIONS[section].categories.map((key) => (
              <a href={href(`/c/${key}/`)} aria-current={here(category === key)}>
                {CATEGORIES[key]}
              </a>
            ))
          }
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <div class="rail-col">
        <Rail section={section} posts={railPosts} />
      </div>
    </div>
    <Signals />
    <script is:inline>
      // X 공식 임베드: 사진·영상이 붙은 트윗(.twitter-tweet, Card.astro)을 실제로 보게 될 때 X 위젯으로 바꿔 그린다.
      // 속보 목록의 카드는 닫혀 있으므로 카드를 열 때 그 카드만 그린다. 긴 글 등 늘 보이는 곳은 바로 그린다.
      (() => {
        const theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        let loading;
        const widgets = () =>
          (loading ??= new Promise((resolve) => {
            const s = document.createElement('script');
            s.src = 'https://platform.twitter.com/widgets.js';
            s.async = true;
            s.onload = () => window.twttr.ready(resolve);
            document.body.append(s);
          }));
        const render = (root) => {
          const tweets = [...root.querySelectorAll('.twitter-tweet:not([data-theme])')];
          if (!tweets.length) return;
          tweets.forEach((el) => (el.dataset.theme = theme));
          widgets().then((twttr) => twttr.widgets.load(root));
        };
        document.querySelectorAll('details').forEach((d) =>
          d.addEventListener('toggle', () => d.open && render(d)),
        );
        document.querySelectorAll('.twitter-tweet').forEach((el) => {
          const d = el.closest('details');
          if (!d || d.open) render(d ?? el.parentElement);
        });
      })();
    </script>
  </body>
</html>

<style>
  /* 900 미만: 1단. 분류 메뉴와 곁줄을 숨긴다 */
  .shell {
    max-width: calc(var(--col-feed) + var(--gutter) * 2);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .side {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    padding-top: var(--s-5);
    padding-bottom: var(--s-6);
  }

  .site-name {
    color: var(--text);
    font-size: var(--fs-title);
    font-weight: 700;
  }

  nav {
    display: flex;
    gap: var(--s-4);
  }

  nav a {
    color: var(--muted);
    /* 터치 타깃 44px 확보 */
    padding: var(--s-3) 0;
  }

  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 500;
  }

  .categories,
  .rail-col {
    display: none;
  }

  main {
    min-width: 0;
    padding-bottom: var(--s-7);
  }

  /* 900 이상: 왼쪽 메뉴 + 피드 2단 */
  @media (min-width: 900px) {
    .shell {
      max-width: none;
      display: grid;
      grid-template-columns: var(--col-side) var(--col-feed);
      justify-content: center;
      column-gap: var(--col-gap);
    }

    .side {
      position: sticky;
      top: 0;
      align-self: start;
      max-height: 100vh;
      overflow-y: auto;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      justify-content: flex-start;
      gap: var(--s-5);
      padding-bottom: var(--s-5);
    }

    nav {
      flex-direction: column;
      gap: 0;
    }

    nav a {
      padding: var(--s-2) 0;
    }

    .categories {
      display: flex;
      font-size: var(--fs-small);
    }

    .categories a {
      padding: var(--s-1) 0;
    }

    main {
      padding-top: var(--s-5);
    }
  }

  /* 1240 이상: 오른쪽 곁줄까지 3단 */
  @media (min-width: 1240px) {
    .shell {
      grid-template-columns: var(--col-side) var(--col-feed) var(--col-rail);
    }

    .rail-col {
      display: block;
      position: sticky;
      top: 0;
      align-self: start;
      max-height: 100vh;
      overflow-y: auto;
      padding: var(--s-5) 0;
    }
  }
</style>
