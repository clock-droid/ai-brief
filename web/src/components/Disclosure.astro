---
import { timeLabel } from '../lib/format';

interface Props {
  /** 주소 #id로 열 수 있게 붙는 id */
  id: string;
  time: Date;
  title: string;
}

// 목록의 한 줄: 시각과 제목만 보이고, 제목을 누르면 그 자리 아래로 내용(slot)이 열린다.
// 여러 개를 함께 열어 둘 수 있다. 속보 카드(Card.astro)와 긴 글 목록이 같이 쓴다.
const { id, time, title } = Astro.props;
---

<article class="row" id={id}>
  <details>
    <summary>
      <time datetime={time.toISOString()}>{timeLabel(time)}</time>
      <h2>{title}</h2>
    </summary>
    <div class="content">
      <slot />
    </div>
  </details>
</article>

<script>
  // 주소가 줄을 가리키면(#id) 그 줄을 열어 둔다
  function openTarget() {
    const id = decodeURIComponent(location.hash.slice(1));
    const details = id ? document.getElementById(id)?.querySelector('details') : null;
    if (details) details.open = true;
  }
  openTarget();
  addEventListener('hashchange', openTarget);
</script>

<style>
  summary {
    display: grid;
    grid-template-columns: var(--time-col) 1fr;
    column-gap: var(--s-3);
    align-items: baseline;
    padding: var(--s-3) 0;
    cursor: pointer;
    list-style: none;
  }

  /* 기본 삼각형 표시를 쓰지 않는다 (아이콘 없음 원칙). 열림은 아래로 펼쳐지는 내용이 말한다 */
  summary::-webkit-details-marker {
    display: none;
  }

  summary time {
    font-size: var(--fs-meta);
    color: var(--muted);
  }

  h2 {
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: var(--lh-title);
  }

  summary:hover h2 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* 펼친 내용은 제목 첫 글자에 맞춘다 */
  .content {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-left: calc(var(--time-col) + var(--s-3));
    padding-bottom: var(--s-5);
  }
</style>
