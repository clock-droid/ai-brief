---
import { timeLabel } from '../lib/format';

interface Props {
  /** 주소 #id로 열 수 있게 붙는 id */
  id: string;
  /** 취향 신호에 쓰는 글 id (cards/<id>, posts/<id>). 펼침·읽은 시간·원문 클릭을 기록한다 (Signals.astro) */
  signal?: string;
  time: Date;
  title: string;
}

// 목록의 한 줄: 시각과 제목만 보이고, 제목을 누르면 그 자리 아래로 내용(slot)이 열린다.
// 여러 개를 함께 열어 둘 수 있다. 속보 카드(Card.astro)와 긴 글 목록이 같이 쓴다.
const { id, signal, time, title } = Astro.props;
---

<article class="row" id={id} data-signal={signal}>
  <details>
    <summary>
      <time datetime={time.toISOString()}>{timeLabel(time)}</time>
      <h2>{title}</h2>
      {
        signal && (
          <span class="marks" role="img" data-marks={signal} hidden>
            {/* 선 아이콘(1.5px 획). 이 브라우저에서 누른 것만 보인다 */}
            <svg data-mark="like" viewBox="0 0 24 24" hidden>
              <path d="M12 20 4.6 12.6a4.6 4.6 0 0 1 6.5-6.5l.9.9.9-.9a4.6 4.6 0 0 1 6.5 6.5Z" />
            </svg>
            <svg data-mark="dislike" viewBox="0 0 24 24" hidden>
              <path d="M12 20 4.6 12.6a4.6 4.6 0 0 1 6.5-6.5l.9.9.9-.9a4.6 4.6 0 0 1 6.5 6.5Z" />
              <path d="m12 7-1.6 4 3 2-1.4 4" />
            </svg>
            <svg data-mark="bookmark" viewBox="0 0 24 24" hidden>
              <path d="M6.5 3.5h11v17L12 15.8l-5.5 4.7Z" />
            </svg>
          </span>
        )
      }
    </summary>
    <div class="content">
      <slot />
    </div>
  </details>
</article>

<script>
  import { readBookmarks } from '../lib/bookmarks';
  import { getVote } from '../lib/signals';

  // 제목 뒤 표시: 이 브라우저에서 누른 반응과 북마크. 접힌 줄만 봐도 알 수 있게 한다
  const MARKS = [
    { key: 'like', label: '좋아요 누름', on: (id: string) => getVote(id)?.v === 1 },
    { key: 'dislike', label: '싫어요 누름', on: (id: string) => getVote(id)?.v === -1 },
    { key: 'bookmark', label: '북마크함', on: (id: string, saved: Set<string>) => saved.has(id) },
  ];

  function paintMarks() {
    const saved = new Set(readBookmarks().map(({ id }) => id));
    document.querySelectorAll<HTMLElement>('[data-marks]').forEach((el) => {
      const id = el.dataset.marks!;
      const on = MARKS.filter((m) => m.on(id, saved));
      el.hidden = on.length === 0;
      for (const m of MARKS) el.querySelector<SVGElement>(`[data-mark="${m.key}"]`)!.toggleAttribute('hidden', !on.includes(m));
      el.setAttribute('aria-label', on.map((m) => m.label).join(', '));
    });
  }
  paintMarks();
  addEventListener('aib:marks', paintMarks);
  addEventListener('storage', paintMarks);
  addEventListener('pageshow', paintMarks);

  // 주소가 줄을 가리키면(#id) 그 줄을 열어 둔다
  function openTarget() {
    const id = decodeURIComponent(location.hash.slice(1));
    const details = id ? document.getElementById(id)?.querySelector('details') : null;
    if (details) details.open = true;
  }
  openTarget();
  addEventListener('hashchange', openTarget);
</script>

<style>
  summary {
    display: grid;
    grid-template-columns: var(--time-col) 1fr auto;
    column-gap: var(--s-3);
    align-items: baseline;
    padding: var(--s-3) 0;
    cursor: pointer;
    list-style: none;
  }

  /* 기본 삼각형 표시를 쓰지 않는다 (아이콘은 오른쪽 상태 표시에만 쓴다). 열림은 아래로 펼쳐지는 내용이 말한다 */
  summary::-webkit-details-marker {
    display: none;
  }

  summary time {
    font-size: var(--fs-meta);
    color: var(--muted);
  }

  h2 {
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: var(--lh-title);
  }

  /* 줄 맨 오른쪽 칸. 제목 첫 줄 높이에 맞춘다 */
  .marks {
    display: flex;
    gap: var(--s-1);
    align-self: start;
    padding-top: 0.15em;
    color: var(--muted);
  }

  .marks svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .marks[hidden],
  .marks svg[hidden] {
    display: none;
  }

  summary:hover h2 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* 펼친 내용은 제목 첫 글자에 맞춘다 */
  .content {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-left: calc(var(--time-col) + var(--s-3));
    padding-bottom: var(--s-5);
  }
</style>
