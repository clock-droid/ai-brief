---
import { DISLIKE_REASONS, LIKE_REASONS } from '../lib/signals';

interface Props {
  /** cards/<id> 또는 posts/<id> */
  id: string;
}

// 글 반응: 좋아요·싫어요, 누르면 이유가 펼쳐진다 (고르지 않아도 된다).
// 토큰이 있는 브라우저(주인)에게만 보인다. 기록은 lib/signals.ts가 비공개 저장소로 보낸다.
const { id } = Astro.props;
---

<div class="feedback" data-feedback={id} hidden>
  <p>
    <button type="button" data-v="1" aria-pressed="false">좋아요</button>
    <span aria-hidden="true"> · </span>
    <button type="button" data-v="-1" aria-pressed="false">싫어요</button>
  </p>
  <p class="reasons" data-for="1" hidden>
    {LIKE_REASONS.map((r) => <button type="button" data-why={r} aria-pressed="false">{r}</button>)}
  </p>
  <p class="reasons" data-for="-1" hidden>
    {DISLIKE_REASONS.map((r) => <button type="button" data-why={r} aria-pressed="false">{r}</button>)}
  </p>
</div>

<script>
  import { enabled, flush, getVote, setVote, type Vote } from '../lib/signals';

  // 반응은 읽은 기록과 달리 바로 보낸다. 이유를 이어서 고를 틈으로 2초 기다렸다 한 번에
  let pending: ReturnType<typeof setTimeout> | undefined;
  const sendSoon = () => {
    clearTimeout(pending);
    pending = setTimeout(flush, 2000);
  };

  function paint(root: HTMLElement, vote: Vote | null) {
    root.querySelectorAll<HTMLButtonElement>('[data-v]').forEach((b) => {
      b.setAttribute('aria-pressed', String(Number(b.dataset.v) === vote?.v));
    });
    root.querySelectorAll<HTMLElement>('.reasons').forEach((p) => {
      p.hidden = Number(p.dataset.for) !== vote?.v;
      p.querySelectorAll<HTMLButtonElement>('[data-why]').forEach((b) => {
        b.setAttribute('aria-pressed', String(!!vote?.why.includes(b.dataset.why!)));
      });
    });
  }

  if (enabled()) {
    document.querySelectorAll<HTMLElement>('[data-feedback]').forEach((root) => {
      const id = root.dataset.feedback!;
      root.hidden = false;
      paint(root, getVote(id));
      root.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('button');
        if (!btn) return;
        const cur = getVote(id);
        let next: Vote | null = cur;
        if (btn.dataset.v) {
          const v = Number(btn.dataset.v) as 1 | -1;
          next = cur?.v === v ? null : { v, why: [] }; // 같은 쪽을 다시 누르면 취소
        } else if (btn.dataset.why && cur) {
          const why = btn.dataset.why;
          next = { v: cur.v, why: cur.why.includes(why) ? cur.why.filter((w) => w !== why) : [...cur.why, why] };
        }
        setVote(id, next);
        sendSoon();
        paint(root, next);
        dispatchEvent(new Event('aib:marks')); // 제목 뒤 표시(Disclosure.astro)를 다시 그린다
      });
    });
  }
</script>

<style>
  .feedback {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .reasons {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-3);
  }

  [hidden] {
    display: none;
  }

  button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  button:hover {
    color: var(--text);
  }

  /* 고른 것: 본문색 + 500 (왼쪽 메뉴의 현재 위치 표시와 같은 문법) */
  button[aria-pressed='true'] {
    color: var(--text);
    font-weight: 500;
  }

  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
